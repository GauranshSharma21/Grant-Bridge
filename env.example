# IBM WatsonX / Granite credentials
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model IDs
GRANITE_MODEL_ID=ibm/granite-3-2-8b-instruct
GRANITE_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr-v2

# ChromaDB settings
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=grant_knowledge_base

# Application settings
APP_SECRET_KEY=grantbridge-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Rate limiting
MAX_API_CALLS_PER_MINUTE=20
MAX_TOKENS_PER_REQUEST=4096
MAX_AGENT_ITERATIONS=10
MAX_EXECUTION_SECONDS=120

# Data paths
UPLOAD_DIR=./data/uploads
LOG_DIR=./logs

# Operational
DEBUG_MODE=False
LOG_LEVEL=INFO
ENABLE_AUDIT_TRAIL=True

